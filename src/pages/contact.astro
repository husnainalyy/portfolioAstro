---
import BaseLayout from "../layouts/BaseLayout.astro";
import supabase from "../components/lib/supabase";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm";
---

<BaseLayout
  title="Contact"
  description="Full stack Web & Mobile Developer | Lahore, Pakistan"
>
  <main class="stack gap-10">
    <div class="wrapper about">
      <Hero
        title="Contact Me"
        tagline="Reach out and let me know if you'd like to collaborate with me on my linkedin!"
      />
      
      <div class="form"><ContactForm client:load /></div>
    </div>
  </main>
</BaseLayout>

<style>
  .about {
    gap: 0;
  }
</style>
