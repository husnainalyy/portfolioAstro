---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ExperienceList } from "../components/Experience";
import { EducationList } from "../components/Education";
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="Husnain ALi Portfolio"
  description="Full Stack Web & Mobile Developer | Lahore, Pakistan"
>
  <main class="stack gap-20">
    <div class="wrapper about">
      <Hero
        title="About Me"
        tagline="I’m not just writing code; I’m brewing up tech potions that make users' brains do backflips."
      >
        <img
          width="1553"
          height="873"
          src="/assets/about.jpg"
          alt="Husnain competition photo"
        />
      </Hero>

      <section>
        <h2 class="section-title">🔮 Background</h2>
        <div class="content">
          <p>
            With a year of hands-on experience in full-stack development and web design, I’ve tackled over 30+ diverse projects and products through freelancing. Leading a skilled team of 4 at my agency, I specialize in helping local businesses navigate the digital landscape with innovative strategies that amplify their online presence and drive tangible growth. From conceptualization to execution, I ensure that each project delivers both functionality and aesthetic appeal. I thrive on the challenge of transforming complex requirements into user-friendly solutions and take pride in the impact my work has on our clients' success. My role involves not only technical development but also strategic planning and client communication to ensure we exceed expectations.            </p><br />
          <p>
            My professional journey is powered by a relentless curiosity and a love for technology. I immerse myself in the latest tech podcasts, explore a wide range of digital trends, and dive into thought-provoking books to stay informed and inspired. This continuous learning not only enriches my technical expertise but also fuels my creativity and problem-solving skills. By staying up-to-date with emerging technologies and industry advancements, I am able to bring innovative solutions to the table and anticipate future trends. Balancing my professional ambitions with my personal interests keeps me energized and motivated, allowing me to approach each project with fresh perspectives and innovative solutions. This blend of curiosity and passion drives me to constantly improve and push the boundaries of what’s possible in digital development.
          </p>
        </div>
      </section>
      <section>
        <h3 class="section-title">💡 Experience</h3>
        <ExperienceList client:load />
      </section>
      <section>
        <h3 class="section-title">🎓 Education</h3>
        <EducationList client:load />
      </section>
      <section>
        <h2 class="section-title">🔨 Skills</h2>
        <div class="tag-bubble">
          <div class="tagGIS">JavaScript</div>
          <div class="tagGIS">TypeScript</div>
          <div class="tagGIS">CSS</div>
          <div class="tagGIS">React</div>
          <div class="tagGIS">Node.js</div>
          <div class="tagGIS">Next.js</div>
          <div class="tagGIS">Express</div>
          <div class="tagGIS">RESTful API</div>
          <div class="tagGIS">React Router</div>
          <div class="tagGIS">UI Design</div>
          <div class="tagGIS">Gsap</div>
          <div class="tagGIS">Axios</div>
          <div class="tagGIS">Redux</div>
          <div class="tagGIS">Tailwind</div>
          <div class="tagGIS">Editor js</div>
          <div class="tagGIS">Fire base</div>
          <div class="tagGIS">Vite</div>
          <div class="tagGIS">Astro</div>
          <div class="tagGIS">Figma</div>
          <div class="tagGIS">Three js</div>
          <div class="tagGIS">SEO/GA4</div>
          <div class="tagGIS">React Native</div>
          <div class="tagGIS">Blockchain</div>
          <div class="tagGIS">AWS</div>
        </div>
      </section>
    </div>

    <ContactCTA />
  </main>

  <style>
    .two-column-list {
      columns: 2; /* Create two columns */
      column-gap: 20px; /* Adjust the gap between columns as needed */
    }

    .job-title,
    .duration,
    .location {
      padding-left: 1em;
      padding-top: 0.5em;
    }

    .about {
      display: flex;
      flex-direction: column;
      gap: 3.5rem;
    }

    img {
      margin-top: 1.5rem;
      border-radius: 1.5rem;
      box-shadow: var(--shadow-md);
    }

    section {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      color: var(--gray-200);
    }

    .section-title {
      grid-column-start: 1;
      font-size: var(--text-xl);
      color: var(--gray-0);
      text-align: center;
    }

    .content :global(a) {
      text-decoration: 1px solid underline transparent;
      text-underline-offset: 0.25em;
      transition: text-decoration-color var(--theme-transition);
    }

    .content :global(a:hover),
    .content :global(a:focus) {
      text-decoration-color: currentColor;
    }

    .tag-bubble {
      display: flex;
      flex-direction: row;
      gap: 0.5em;
      overflow-wrap: break-word;
      flex-wrap: wrap;
      text-wrap: balance;
      padding-top: 1em;
      justify-content: flex-start;
    }

    .tagGIS {
      background-color: var(--gray-900);
      border-radius: 100em;
      padding: 0.25em 1em;
      font-size: 1em;
      color: var(--gray-50);
    }

    li {
      list-style: circle;
      font-size: 0.75em;
      text-wrap: pretty;
      margin-left: 3em;
      line-height: 2;
    }

    @media (min-width: 50em) {
      .content h5 {
        font-size: var(--text-2xl);
      }

      .about > :global(:first-child) {
        grid-column-start: 2;
      }

      section {
        display: contents;
        font-size: var(--text-lg);
      }

      .section-title {
        text-align: left;
        font-size: 2.5em;
      }
    }
  </style>
</BaseLayout>
